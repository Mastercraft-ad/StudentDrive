modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 36029
externalPort = 4200

[[ports]]
localPort = 39759
externalPort = 3000

[[ports]]
localPort = 40291
externalPort = 5173

[[ports]]
localPort = 42959
externalPort = 3002

[[ports]]
localPort = 43959
externalPort = 5000

[[ports]]
localPort = 44691
externalPort = 3003

[[ports]]
localPort = 45303
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]
